# tcptarpit(8) configuration file.
#
# Copy this file to /etc/tcptarpit.conf and adjust as needed.  The daemon
# also runs with the built-in defaults listed below if the file is
# absent; a malformed file aborts startup.

# IPv4 address to listen on.  The loopback default keeps the tarpit
# unreachable from the outside; only pf rdr-to traffic arrives here.
# Empty string disables the IPv4 listener.
#listen_ip=127.0.0.1

# IPv6 address to listen on (empty string disables the IPv6
# listener).  By default both families are enabled; pf needs
# separate inet6 rules with rdr-to ::1 for IPv6 traffic.
#listen_ip6=::1

# Port to listen on.  Must match the rdr-to rule in /etc/pf.conf.
#listen_port=8024

# Seconds between cleanup passes over stale connections.
#cleanup_interval=1800

# Maximum age of a held connection in seconds before the daemon closes
# it with a FIN.  The effective hold time lies between max_age and
# max_age + cleanup_interval.
#max_age=1800

# Stutter, like spamd(8): seconds per filler byte dribbled back to the
# trapped client.  Keeps bots waiting for a real response; 0 disables
# stuttering for pure silence.  Total dribble is capped internally so
# the send buffer can never fill up.
#stutter=1

# Log file.  Empty logs to stdout, which daemon(8) pipes to syslog
# (daemon.info -> /var/log/daemon).  Set to log into a dedicated file
# instead; see the newsyslog(8) example in tcptarpit(8) for rotation.
# The file must be writable by the daemon user.
#log_file=

# PID file, used by newsyslog(8) to signal the daemon after log
# rotation.  When dropping privileges, use a directory writable by
# the daemon user, e.g. /var/run/tcptarpit/tcptarpit.pid.
#pid_file=

# Privilege drop: switch to this user (and group) after the listen
# socket, log file and pid file are opened.  Empty = no drop.  If the
# daemon is already started unprivileged (rc.subr daemon_user), the
# drop is a no-op.  Port 8024 needs no root.
#user=
#group=
