#!/bin/ksh

# tcptarpit rc.d(8) script -- installed by the package as /etc/rc.d/tcptarpit
# and enabled with: rcctl enable tcptarpit && rcctl start tcptarpit

# Interpreted daemon: run the interpreter with the script as a flag.
# rc.subr(8) always rebuilds pexp from daemon + daemon_flags (verified
# on OpenBSD 7.9: "pexp=\"$(eval echo ${daemon}${daemon_flags:+ ...})\"",
# custom pexp values are overwritten), so this way both the start
# command and pexp become "/usr/bin/perl /usr/local/bin/tcptarpit.pl"
# and match the process list.  Additional flags (e.g. an alternative
# config file) must keep the script path:
#   rcctl set tcptarpit flags "/usr/local/bin/tcptarpit.pl /etc/x.conf"
daemon="/usr/bin/perl"
daemon_flags="/usr/local/bin/tcptarpit.pl"

# daemon(8) pipes stdout/stderr to syslog with this facility.level
daemon_logger="daemon.info"

# Run unprivileged: the _tcptarpit user/group is created automatically
# by pkg_add(1) (@newuser/@newgroup in the package PLIST).  For manual
# installations create it first, see README.md.
daemon_user="_tcptarpit"

. /etc/rc.d/rc.subr

rc_reload=NO
rc_bg=YES

rc_cmd $1
