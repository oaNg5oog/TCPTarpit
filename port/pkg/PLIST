@comment uid/gid 960 chosen locally, above the OpenBSD ports registry
@comment range (registry ends below 910); change both numbers on collision.
@newgroup _tcptarpit:960
@newuser _tcptarpit:960:960:tcptarpit:tcptarpit daemon:/nonexistent:/sbin/nologin
@rcscript ${RCDIR}/tcptarpit
bin/tcptarpit.pl
@man man/man8/tcptarpit.8
share/doc/pkg-readmes/tcptarpit
@exec echo "tcptarpit installed - post-installation guide: ${PREFIX}/share/doc/pkg-readmes/tcptarpit"
@exec echo "quick start: rcctl enable tcptarpit && rcctl start tcptarpit"
share/doc/tcptarpit/
share/doc/tcptarpit/CHANGES
share/examples/tcptarpit/
share/examples/tcptarpit/login.conf.d/
share/examples/tcptarpit/login.conf.d/tcptarpit
share/examples/tcptarpit/tcptarpit.conf
@sample ${SYSCONFDIR}/login.conf.d/tcptarpit
@exec [ -f ${SYSCONFDIR}/login.conf.d/tcptarpit ] && cap_mkdb ${SYSCONFDIR}/login.conf.d/tcptarpit
@exec id _tcptarpit >/dev/null 2>&1 && usermod -L tcptarpit _tcptarpit || true
@sample ${SYSCONFDIR}/tcptarpit.conf
@comment runtime dirs and log file for the default file logging
@exec [ -d /var/run/tcptarpit ] || install -d -o _tcptarpit -g _tcptarpit /var/run/tcptarpit
@exec [ -f /var/log/tcptarpit.log ] || install -o _tcptarpit -g _tcptarpit -m 0640 /dev/null /var/log/tcptarpit.log
@comment newsyslog rotation entry (idempotent, editable by the admin)
@exec grep -q tcptarpit.log /etc/newsyslog.conf || printf '# tcptarpit - added by the package, adjust to your needs\n/var/log/tcptarpit.log _tcptarpit:_tcptarpit 640 7 250 * Z /var/run/tcptarpit/tcptarpit.pid\n' >> /etc/newsyslog.conf
